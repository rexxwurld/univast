<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UNIVAST.Mobile.ViewModels"
             x:Class="UNIVAST.Mobile.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Log in"
             BackgroundColor="{StaticResource UvBackground}">

    <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">

        <Label Text="Welcome back"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="{StaticResource UvText}" />

        <Label Text="Log in to save places and write reviews."
               FontSize="14"
               TextColor="{StaticResource UvMuted}"
               Margin="0,0,0,10" />

        <Border BackgroundColor="{StaticResource UvSurface}" StrokeThickness="0" Padding="14,4" StrokeShape="RoundRectangle 12">
            <Entry Text="{Binding Email}" Placeholder="Email" Keyboard="Email" />
        </Border>

        <Border BackgroundColor="{StaticResource UvSurface}" StrokeThickness="0" Padding="14,4" StrokeShape="RoundRectangle 12">
            <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True" />
        </Border>

        <Label Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               TextColor="{StaticResource UvDanger}"
               FontSize="13" />

        <Button Style="{StaticResource PrimaryButton}" Text="Log in"
                Margin="0,10,0,0"
                Command="{Binding LoginCommand}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource UvBlue}" />

        <Button Text="Don't have an account? Register"
                BackgroundColor="Transparent"
                TextColor="{StaticResource UvBlue}"
                Command="{Binding GoToRegisterCommand}" />

    </VerticalStackLayout>

</ContentPage>

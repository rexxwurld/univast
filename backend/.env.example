PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=replace_with_a_long_random_string

# Access token lifetime (short). The long-lived credential is the refresh token.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Comma-separated browser origins allowed by CORS (only needed for a web
# dashboard; the mobile app doesn't use CORS). Unset in production = no browser origins.
CORS_ORIGINS=

# Number of reverse-proxy hops in front of the API (usually 1 on Render/Railway/Nginx).
# Leave unset when running locally.
TRUST_PROXY=

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Community uploads (PDF/photo/video) are written here, outside any served directory.
# REQUIRED in production; defaults to a temp directory otherwise.
UPLOAD_QUARANTINE_DIR=
# Optional per-type size caps in MB (defaults: image 10, pdf 25, video 100).
UPLOAD_MAX_IMAGE_MB=
UPLOAD_MAX_PDF_MB=
UPLOAD_MAX_VIDEO_MB=

# --- General map search (forward geocoding) -----------------------------------------------------------
# Used only when a client asks for it (GET /api/v1/search?geo=1) for a submitted search.
# Default provider is the public OpenStreetMap Nominatim (max 1 request/second, no auto-complete, real contact
# required by its usage policy). For real traffic, self-host Nominatim or point this at a compatible service.
# GEOCODER_SEARCH_URL=https://nominatim.openstreetmap.org/search
# GEOCODER_CONTACT=you@your-domain.example
# Set to "false" to turn general map search off (campus/UNIVAST search keeps working).
# GEOCODER_SEARCH_ENABLED=true

# --- Search performance -------------------------------------------------------------------------------
# Seconds the global-search candidate list is cached (writes through the API invalidate it immediately).
# 0 disables. Default 30 (0 under NODE_ENV=test).
# GLOBAL_SEARCH_CACHE_SECONDS=30

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UNIVAST.Mobile.ViewModels"
             x:Class="UNIVAST.Mobile.Pages.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Log in"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">

        <Label Text="Welcome back"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="#111111" />

        <Label Text="Log in to save places and write reviews."
               FontSize="14"
               TextColor="#777777"
               Margin="0,0,0,10" />

        <Border BackgroundColor="White" StrokeThickness="0" Padding="14,4" StrokeShape="RoundRectangle 12">
            <Entry Text="{Binding Email}" Placeholder="Email" Keyboard="Email" />
        </Border>

        <Border BackgroundColor="White" StrokeThickness="0" Padding="14,4" StrokeShape="RoundRectangle 12">
            <Entry Text="{Binding Password}" Placeholder="Password" IsPassword="True" />
        </Border>

        <Label Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               TextColor="#B00020"
               FontSize="13" />

        <Button Text="Log in"
                BackgroundColor="#1976D2"
                TextColor="White"
                CornerRadius="24"
                HeightRequest="50"
                Margin="0,10,0,0"
                Command="{Binding LoginCommand}" />

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#1976D2" />

        <Button Text="Don't have an account? Register"
                BackgroundColor="Transparent"
                TextColor="#1976D2"
                Command="{Binding GoToRegisterCommand}" />

    </VerticalStackLayout>

</ContentPage>

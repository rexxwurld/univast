<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UNIVAST.Mobile.Pages.AddPlacePage"
             Title="Add a place"
             BackgroundColor="{StaticResource UvBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">

            <Label x:Name="LocationLabel" FontSize="13" TextColor="{StaticResource UvMuted}" />

            <Border BackgroundColor="{StaticResource UvSurface}" StrokeThickness="0" Padding="14,4" StrokeShape="RoundRectangle 12">
                <Entry x:Name="NameEntry" Placeholder="Place name *" MaxLength="200" />
            </Border>

            <Border BackgroundColor="{StaticResource UvSurface}" StrokeThickness="0" Padding="14,4" StrokeShape="RoundRectangle 12">
                <Picker x:Name="CategoryPicker" Title="Category *" />
            </Border>

            <Border BackgroundColor="{StaticResource UvSurface}" StrokeThickness="0" Padding="14,4" StrokeShape="RoundRectangle 12">
                <Entry x:Name="AddressEntry" Placeholder="Address (filled in from your location)" MaxLength="300" />
            </Border>

            <Border BackgroundColor="{StaticResource UvSurface}" StrokeThickness="0" Padding="14,4" StrokeShape="RoundRectangle 12">
                <Entry x:Name="PhoneEntry" Placeholder="Phone (optional)" Keyboard="Telephone" MaxLength="40" />
            </Border>

            <Border BackgroundColor="{StaticResource UvSurface}" StrokeThickness="0" Padding="14,4" StrokeShape="RoundRectangle 12">
                <Entry x:Name="WebsiteEntry" Placeholder="Website (optional)" Keyboard="Url" MaxLength="300" />
            </Border>

            <Border BackgroundColor="{StaticResource UvSurface}" StrokeThickness="0" Padding="14,8" StrokeShape="RoundRectangle 12">
                <Editor x:Name="DescriptionEditor"
                        Placeholder="What is this place? (optional)"
                        AutoSize="TextChanges"
                        MaxLength="2000"
                        HeightRequest="100" />
            </Border>

            <HorizontalStackLayout Spacing="12">
                <Button x:Name="PhotoButton"
                        Text="Add photo"
                        BackgroundColor="{StaticResource UvSurface}"
                        TextColor="{StaticResource UvText}"
                        CornerRadius="20"
                        Clicked="Photo_Clicked" />
                <Label x:Name="PhotoLabel" VerticalOptions="Center" FontSize="13" TextColor="{StaticResource UvMuted}" />
            </HorizontalStackLayout>

            <Label x:Name="ErrorLabel" IsVisible="False" TextColor="{StaticResource UvDanger}" FontSize="13" />

            <Button Style="{StaticResource PrimaryButton}" x:Name="SubmitButton"
                    Text="Add place"
                    Clicked="Submit_Clicked" />

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource UvBlue}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UNIVAST.Mobile.Pages.PlaceDetailPage"
             Title="Place"
             BackgroundColor="#F5F5F5">

    <Grid>

        <ActivityIndicator x:Name="LoadingIndicator"
                            IsRunning="True"
                            IsVisible="True"
                            Color="#1976D2"
                            VerticalOptions="Center"
                            HorizontalOptions="Center" />

        <Label x:Name="ErrorLabel"
               IsVisible="False"
               Text="Couldn't load this place."
               TextColor="#B00020"
               FontSize="16"
               Margin="24"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

        <ScrollView x:Name="ContentScroll" IsVisible="False">
            <VerticalStackLayout Padding="20" Spacing="14">

                <Label x:Name="NameLabel"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#111111" />

                <Label x:Name="CategoryLabel"
                       FontSize="14"
                       TextColor="#1976D2" />

                <Label x:Name="RatingLabel"
                       FontSize="14"
                       TextColor="#555555" />

                <Label x:Name="DistanceLabel"
                       FontSize="13"
                       TextColor="#777777"
                       IsVisible="False" />

                <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,8" />

                <Label x:Name="DescriptionLabel"
                       FontSize="15"
                       TextColor="#333333"
                       IsVisible="False" />

                <Label x:Name="AddressLabel"
                       FontSize="14"
                       TextColor="#555555"
                       IsVisible="False" />

                <Label x:Name="PhoneLabel"
                       FontSize="14"
                       TextColor="#555555"
                       IsVisible="False" />

                <Label x:Name="WebsiteLabel"
                       FontSize="14"
                       TextColor="#1976D2"
                       IsVisible="False" />

                <VerticalStackLayout Spacing="10" Margin="0,16,0,0">

                    <Button x:Name="DirectionsButton"
                            Text="🧭  Open in Maps"
                            BackgroundColor="#1976D2"
                            TextColor="White"
                            CornerRadius="24"
                            HeightRequest="50"
                            Clicked="Directions_Clicked" />

                    <Button x:Name="NavigateCampusButton"
                            Text="🏫  Navigate inside campus"
                            IsVisible="False"
                            BackgroundColor="#1976D2"
                            TextColor="White"
                            CornerRadius="24"
                            HeightRequest="50"
                            Clicked="NavigateCampus_Clicked" />

                    <Button x:Name="SaveButton"
                            Text="☆  Save"
                            BackgroundColor="White"
                            TextColor="#111111"
                            BorderColor="#CCCCCC"
                            BorderWidth="1"
                            CornerRadius="24"
                            HeightRequest="50"
                            Clicked="Save_Clicked" />

                    <Button x:Name="CallButton"
                            Text="📞  Call"
                            IsVisible="False"
                            BackgroundColor="White"
                            TextColor="#111111"
                            BorderColor="#CCCCCC"
                            BorderWidth="1"
                            CornerRadius="24"
                            HeightRequest="50"
                            Clicked="Call_Clicked" />

                    <Button x:Name="WriteReviewButton"
                            Text="✍️  Write a review"
                            BackgroundColor="White"
                            TextColor="#111111"
                            BorderColor="#CCCCCC"
                            BorderWidth="1"
                            CornerRadius="24"
                            HeightRequest="50"
                            Clicked="WriteReview_Clicked" />

                    <Button x:Name="ClaimBusinessButton"
                            Text="🏷️  Claim this business"
                            BackgroundColor="White"
                            TextColor="#111111"
                            BorderColor="#CCCCCC"
                            BorderWidth="1"
                            CornerRadius="24"
                            HeightRequest="50"
                            Clicked="ClaimBusiness_Clicked" />

                    <Button x:Name="ReportPlaceButton"
                            Text="🚩  Report this place"
                            BackgroundColor="Transparent"
                            TextColor="#B00020"
                            HeightRequest="44"
                            Clicked="ReportPlace_Clicked" />

                </VerticalStackLayout>

                <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,16,0,8" />

                <Label Text="Reviews" FontSize="18" FontAttributes="Bold" TextColor="#111111" />

                <Label x:Name="NoReviewsLabel"
                       Text="No reviews yet — be the first."
                       FontSize="14"
                       TextColor="#777777"
                       IsVisible="False" />

                <VerticalStackLayout x:Name="ReviewsList" Spacing="12" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
